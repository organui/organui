{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "consumers": {
      "dependsOn": ["@workspace/registry#build"],
      "env": ["REGISTRY_GITHUB_REF"],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["consumers", "web#build"],
      "cache": false
    }
  }
}
