{
  "extends": "@workspace/typescript-config/react-library.json",
  // Registry source is copied into apps that resolve imports like a bundler.
  "compilerOptions": {
    "types": ["bun"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Items import shadcn components from the consumer's ui alias. Here that
    // alias points at the base-nova copies the docs site installs.
    "paths": {
      "@/components/ui/*": ["../ui/src/components/*"]
    }
  },
  "include": ["registry", "scripts", "tests"]
}
