{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/registry#build": {
      "outputs": ["dist/**"]
    },
    "web#stage-registry": {
      "dependsOn": ["@workspace/registry#build"],
      "outputs": ["public/r/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "stage-registry"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["VERCEL_ENV"]
    },
    "web#dev": {
      "dependsOn": ["stage-registry"],
      "cache": false,
      "persistent": true
    },
    "test": {}
  }
}
