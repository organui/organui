# OrganUI needs no environment variables to develop, build or test. These are
# set for you where they matter; uncomment one in the package's own .env to
# override it locally.

# apps/web: Vercel sets this. Only "production" lets search engines index the
# site (robots.ts, the root layout).
# VERCEL_ENV=production

# apps/web: `bun run thumbnails` sets this to serve the uncredited organ pages
# it screenshots, under `next dev` only.
# ORGANUI_THUMBNAILS=1

# packages/registry-e2e: the commit the GitHub-registry consumer installs
# from. CI sets it to the commit under test.
# REGISTRY_GITHUB_REF=master
