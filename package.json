{
  "name": "organui",
  "version": "0.2.0",
  "private": false,
  "description": "Open UI building blocks for healthcare and life-science products.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "registry:validate": "shadcn registry validate registry.json",
    "registry:build": "shadcn build registry.json",
    "registry:check": "npm run registry:metadata && npm run registry:validate && npm run registry:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry-install": "node scripts/test-registry-install.mjs",
    "registry:metadata": "node scripts/validate-organui-metadata.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check": "npm run registry:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "jsdom": "^29.1.1",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "^16.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "license": "MIT",
  "overrides": {
    "postcss": "8.5.12",
    "sharp": "0.35.0",
    "@hono/node-server": "2.0.10"
  }
}
