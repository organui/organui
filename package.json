{
  "name": "organui",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:consumers": "turbo run consumers",
    "test:browser": "turbo run test:browser",
    "format:check": "prettier --check .",
    "test:cache": "bun scripts/check-registry-cache.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-version.ts && prettier --write packages/registry/CHANGELOG.md package.json packages/registry/package.json",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT"
}
